{
  "name": "remote-access-server",
  "version": "1.0.0",
  "description": "Remote Access Server Gateway with WebSocket support",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "set NODE_ENV=development&& nodemon src/index.js",
    "dev:https": "set NODE_ENV=development&& set DEV_HTTPS=1&& nodemon src/index.js",
    "prod": "set NODE_ENV=production&& node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "remote",
    "access",
    "websocket",
    "android"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^13.7.0",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "prom-client": "^15.1.3",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "nodemon": "^3.0.1",
    "selfsigned": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
