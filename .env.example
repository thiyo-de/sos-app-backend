# ============================================================
# Environment variables — copy this file to .env and fill in
# ============================================================
# WARNING: Never commit the real .env file.
#          Add .env to .gitignore immediately.

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Authentication ──────────────────────────────────────────
# SECRET_KEY is used to sign session tokens (HMAC-SHA256).
SECRET_KEY=change-me-to-a-random-64-char-string

# Admin dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ─── WebSocket device authentication ────────────────────────
# WS_DEVICE_SECRET must match the value compiled into the
# Android app's build config (app/build.gradle.kts).
WS_DEVICE_SECRET=change-me-to-match-the-android-client

# ─── Supabase (optional — memory-only fallback if omitted) ──
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-service-role-key

# ─── Firebase Cloud Messaging (optional — FCM disabled if omitted) ──
#
# Choose ONE of the following methods (Priority: 1 > 2 > 3 > 4):
#
# Method 1 (recommended): Raw JSON — single-line compact format, no surrounding quotes
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com",...}
#
# Method 2: Base64-encoded JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of the entire service-account JSON>
#
# Method 3: File path to service-account JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
#
# Method 4 (legacy): Place file at project root as firebase-service-account.json

# ─── Email alerts (optional — disabled if omitted) ──────────
# Sends Gmail notifications when devices come online / go offline /
# complete full protection setup. Requires an App Password:
#   Google Account → Security → 2-Step Verification (must be ON)
#   → App passwords → generate for "Mail".
# Never commit real values; fill these in .env only.
# EMAIL_USER=your.address@gmail.com
# EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_TO=your.address@gmail.com

# ─── Public URL overrides (optional) ─────────────────────────
# Render supplies RENDER_EXTERNAL_URL automatically in production.
# Set RENDER_URL to override the public URL for custom domains
# or staging deployments.
# RENDER_URL=https://custom-domain.example.com